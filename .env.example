# Optional: use Claude for the agents. Without it, the deterministic offline "scripted" provider is used.
ANTHROPIC_API_KEY=
# Optional model override
ANIMATICA_MODEL=claude-sonnet-4-5
# Optional: python interpreter that can `import bpy` (default: current interpreter), or a Blender binary
ANIMATICA_BLENDER_PYTHON=
ANIMATICA_BLENDER_BIN=
# Optional tool locations (defaults: ~/.cache/animatica/...)
ANIMATICA_VOICES_DIR=
ANIMATICA_RHUBARB=
